# ---------------------------------------------------------------------------
# NovaPAY Bank — environment variables
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# ---------------------------------------------------------------------------

# SQLite (local development):
# DATABASE_URL="file:./dev.db"
#
# PostgreSQL (production):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Use a long, random, stable value in
# production (e.g. `openssl rand -base64 32`).
SESSION_SECRET="change-me-to-a-long-random-secret"

# Public base URL of the app. Used for metadata/origin resolution.
# Local: http://localhost:3000   Production: https://your-domain.com
APP_URL="http://localhost:3000"

# Password for the seeded demo administrator.
#
# SECURITY: this value is intentionally NOT stored in source control and is
# never displayed on any page. The seed script refuses to run without it.
# Choose a long random value (e.g. `openssl rand -base64 24`) and keep it out of
# version control. If a previous version of this project shipped a publicly
# visible demo password, rotate the deployed account before exposing it again.
DEMO_USER_PASSWORD=""